{
  "expo": {
    "name": "Walkie Talkie",
    "slug": "walkie-talkie",
    "version": "26.10.15",
    "orientation": "default",
    "icon": "./assets/images/bitcoinwalk-app-icon.png",
    "scheme": "walkietalkie",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/bitcoinwalk-app-icon-ios.png",
      "bundleIdentifier": "org.bitcoinwalk.walkietalkie",
      "buildNumber": "20",
      "supportsTablet": true
    },
    "android": {
      "versionCode": 22,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/bitcoinwalk-app-icon-foreground.png",
        "monochromeImage": "./assets/images/bitcoinwalk-app-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "package": "org.bitcoinwalk.walkietalkie"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-ios-signing",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/bitcoinwalk-splash-mark.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#000000",
            "image": "./assets/images/bitcoinwalk-splash-mark.png"
          },
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/bitcoinwalk-splash-mark.png"
          },
          "ios": {
            "backgroundColor": "#000000",
            "image": "./assets/images/bitcoinwalk-splash.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true,
            "dark": {
              "backgroundColor": "#000000",
              "image": "./assets/images/bitcoinwalk-splash.png"
            }
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to confirm Lightning payments."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "zh",
            "zh-Hant",
            "ar",
            "de",
            "es",
            "fa",
            "fr",
            "hi",
            "hu",
            "it",
            "ja",
            "ko",
            "pl",
            "pt-BR",
            "pt-PT",
            "ru",
            "th",
            "tr"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can send images, add custom emoji, and scan QR codes."
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 10,
              "supportsMovieWithMaxCount": 10,
              "supportsFileWithMaxCount": 10,
              "supportsAttachmentsWithMaxCount": 10
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*",
              "image/*",
              "video/*",
              "audio/*",
              "application/*"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "video/*",
              "audio/*",
              "application/*",
              "*/*"
            ]
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera so you can take photos and scan QR codes."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos and videos to your library.",
          "granularPermissions": [],
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": "Allow $(PRODUCT_NAME) to record voice messages."
        }
      ],
      "expo-image",
      [
        "./plugins/with-local-notifications",
        {
          "icon": "./assets/images/notification-icon.png"
        }
      ],
      "./plugins/with-proximity-bluetooth",
      "./plugins/with-device-orientation-policy",
      "./plugins/with-pointer-hover",
      "./plugins/with-ios-warning-cleanup",
      "./plugins/with-third-party-notices",
      [
        "expo-build-properties",
        {
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ],
      "expo-web-browser",
      "expo-asset",
      "./plugins/with-notification-extension"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
